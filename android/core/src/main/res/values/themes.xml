<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Compose theme owns the real colours; this style only paints the
         window before the first frame and keeps the layout right-to-left. -->
    <style name="Theme.Inspection" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textDirection">rtl</item>
    </style>

    <!-- Only while the app starts: the navy splash with the mark. MainActivity
         switches to Theme.Inspection before drawing anything. -->
    <style name="Theme.Inspection.Starting" parent="Theme.Inspection">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
