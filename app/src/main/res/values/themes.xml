<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Roozban" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/roozban_background</item>
    </style>

    <!-- Quick add over whatever is on screen (Share, widget, tile, shortcut). -->
    <style name="Theme.Roozban.Translucent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.Roozban.Splash" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/roozban_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/roozban_brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Roozban</item>
    </style>
</resources>
