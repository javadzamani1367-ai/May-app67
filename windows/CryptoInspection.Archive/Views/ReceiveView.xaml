<UserControl x:Class="CryptoInspection.Archive.Views.ReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{StaticResource receive_wifi_title}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{StaticResource receive_address}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{StaticResource receive_pair_code}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
                    <Button Content="{StaticResource receive_connect}"
                            Command="{Binding PullCommand}"
                            HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                    <TextBlock Text="{StaticResource receive_usb_hint}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{StaticResource receive_package_title}" Style="{StaticResource SectionTitle}" />
                    <TextBox Text="{Binding PackagePath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="{StaticResource action_browse}" Click="OnBrowse" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{StaticResource receive_package_password}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PackagePassword, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="{StaticResource receive_package_import}"
                            Command="{Binding ImportPackageCommand}"
                            HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{StaticResource receive_log}" Style="{StaticResource SectionTitle}" />
                <ProgressBar DockPanel.Dock="Top" Height="4" IsIndeterminate="True" Margin="0,0,0,8"
                             Visibility="{Binding Busy, Converter={StaticResource BooleanToVisibility}}" />
                <ListBox ItemsSource="{Binding Log}" FontSize="13" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
