<UserControl x:Class="CryptoInspection.Archive.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{StaticResource reports_filters}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{StaticResource filter_from_date}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{StaticResource filter_date_hint}" />
                    <TextBlock Text="{StaticResource filter_to_date}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{StaticResource filter_date_hint}" />
                    <TextBlock Text="{StaticResource column_county}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Counties}" SelectedItem="{Binding County}" />
                    <TextBlock Text="{StaticResource column_status}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" />
                    <Button Content="{StaticResource action_clear_filter}"
                            Command="{Binding ClearFilterCommand}"
                            HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Button Content="{StaticResource export_excel}" Command="{Binding ExportExcelCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="{StaticResource export_pdf}" Command="{Binding ExportPdfCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="{StaticResource export_word}" Command="{Binding ExportWordCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="{StaticResource action_open_folder}" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding Message}" Margin="0,8,0,0" Foreground="{StaticResource PrimaryDarkBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource stats_title}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{StaticResource stats_total}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{StaticResource stats_pending}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{StaticResource stats_visited}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{StaticResource stats_archived}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="{StaticResource stats_total_power}" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Total}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Pending}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Visited}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Archived}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding TotalPower}" FontSize="20" FontWeight="Bold" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource stats_by_type}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding TypeStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" />
                                        <TextBlock HorizontalAlignment="Left" Text="{Binding Count}" FontWeight="Bold" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{StaticResource stats_by_county}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding CountyStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" />
                                        <TextBlock HorizontalAlignment="Left" Text="{Binding Count}" FontWeight="Bold" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
