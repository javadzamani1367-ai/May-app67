<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <!-- Same palette as the phone, so a printed report and the archive screen
         read as one system. Everything is right to left by default. -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF00695C" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#FF004D40" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#FFDDE1E4" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1A1C1E" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF44474A" />

    <FontFamily x:Key="AppFont">/CryptoInspection.Archive;component/Assets/fonts/#Vazirmatn, Tahoma, Segoe UI</FontFamily>

    <Style TargetType="{x:Type Window}">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
        <Setter Property="SelectionMode" Value="Single" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="0,10,0,6" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,6,0,2" />
    </Style>

    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
</ResourceDictionary>
